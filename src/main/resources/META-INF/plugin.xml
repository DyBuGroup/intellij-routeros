<idea-plugin>
  <id>dev.dybug.routeros</id>
  <name>RouterOS Script</name>
  <vendor>dybug</vendor>
  <resource-bundle>messages.RosBundle</resource-bundle>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="RouterOS Script"
              implementationClass="dev.dybug.routeros.RosFileType"
              fieldName="INSTANCE"
              language="RouterOS"
              extensions="rsc"/>
    <lang.parserDefinition language="RouterOS"
                           implementationClass="dev.dybug.routeros.parser.RosParserDefinition"/>
    <lang.syntaxHighlighterFactory language="RouterOS"
                                   implementationClass="dev.dybug.routeros.highlighting.RosSyntaxHighlighterFactory"/>
    <colorSettingsPage implementation="dev.dybug.routeros.highlighting.RosColorSettingsPage"/>
    <lang.braceMatcher language="RouterOS" implementationClass="dev.dybug.routeros.editor.RosBraceMatcher"/>
    <lang.commenter language="RouterOS" implementationClass="dev.dybug.routeros.editor.RosCommenter"/>
    <lang.quoteHandler language="RouterOS" implementationClass="dev.dybug.routeros.editor.RosQuoteHandler"/>
    <lang.foldingBuilder language="RouterOS" implementationClass="dev.dybug.routeros.structure.RosFoldingBuilder"/>
    <lang.psiStructureViewFactory language="RouterOS"
                                  implementationClass="dev.dybug.routeros.structure.RosStructureViewFactory"/>
    <breadcrumbsInfoProvider implementation="dev.dybug.routeros.structure.RosBreadcrumbsProvider"/>
    <lang.elementManipulator forClass="dev.dybug.routeros.psi.impl.RosStringImpl"
                             implementationClass="dev.dybug.routeros.psi.impl.RosStringManipulator"/>
    <multiHostInjector implementation="dev.dybug.routeros.injection.RosScriptInjector"/>
    <annotator language="RouterOS" implementationClass="dev.dybug.routeros.highlighting.RosAnnotator"/>
    <completion.contributor language="RouterOS"
                            implementationClass="dev.dybug.routeros.completion.RosCompletionContributor"/>
    <codeInsight.parameterInfo language="RouterOS"
                               implementationClass="dev.dybug.routeros.completion.RosParameterInfoHandler"/>
    <lang.documentationProvider language="RouterOS"
                                implementationClass="dev.dybug.routeros.documentation.RosDocumentationProvider"/>
    <fileBasedIndex implementation="dev.dybug.routeros.references.RosGlobalIndex"/>
    <lang.findUsagesProvider language="RouterOS" implementationClass="dev.dybug.routeros.references.RosFindUsagesProvider"/>
    <lang.namesValidator language="RouterOS" implementationClass="dev.dybug.routeros.references.RosNamesValidator"/>
    <lang.refactoringSupport language="RouterOS"
                             implementationClass="dev.dybug.routeros.references.RosRefactoringSupportProvider"/>
    <renamePsiElementProcessor implementation="dev.dybug.routeros.references.RosGlobalRenameProcessor"/>
    <findUsagesHandlerFactory implementation="dev.dybug.routeros.references.RosFindUsagesHandlerFactory"/>
    <gotoSymbolContributor implementation="dev.dybug.routeros.references.RosGotoSymbolContributor"/>
    <localInspection language="RouterOS" shortName="RosUndefinedVariable" displayName="Undefined variable" groupName="RouterOS"
                     enabledByDefault="true" level="WEAK WARNING" implementationClass="dev.dybug.routeros.inspections.RosUndefinedVariableInspection"/>
    <localInspection language="RouterOS" shortName="RosUnusedLocal" displayName="Unused local variable" groupName="RouterOS"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.dybug.routeros.inspections.RosUnusedLocalInspection"/>
    <localInspection language="RouterOS" shortName="RosUnknownProperty" displayName="Unknown property" groupName="RouterOS"
                     enabledByDefault="true" level="WEAK WARNING" implementationClass="dev.dybug.routeros.inspections.RosUnknownPropertyInspection"/>
    <localInspection language="RouterOS" shortName="RosValueType" displayName="Value does not match the property type" groupName="RouterOS"
                     enabledByDefault="true" level="WEAK WARNING" implementationClass="dev.dybug.routeros.inspections.RosValueTypeInspection"/>
    <localInspection language="RouterOS" shortName="RosDeprecatedProperty" displayName="Deprecated or v6 property" groupName="RouterOS"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.dybug.routeros.inspections.RosDeprecatedPropertyInspection"/>
    <localInspection language="RouterOS" shortName="RosMissingMandatoryProperty" displayName="Missing mandatory property" groupName="RouterOS"
                     enabledByDefault="true" level="WEAK WARNING" implementationClass="dev.dybug.routeros.inspections.RosMissingMandatoryPropertyInspection"/>
    <localInspection language="RouterOS" shortName="RosShadowedProperty" displayName="Variable shadowed by a property in where" groupName="RouterOS"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.dybug.routeros.inspections.RosShadowedPropertyInspection"/>
    <localInspection language="RouterOS" shortName="RosSpaceBeforeEquals" displayName="Whitespace before '='" groupName="RouterOS"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.dybug.routeros.inspections.RosSpaceBeforeEqualsInspection"/>
    <localInspection language="RouterOS" shortName="RosInvalidVariableName" displayName="Invalid variable name" groupName="RouterOS"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.dybug.routeros.inspections.RosInvalidVariableNameInspection"/>
    <localInspection language="RouterOS" shortName="RosEmptyArray" displayName="Empty array literal" groupName="RouterOS"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.dybug.routeros.inspections.RosEmptyArrayInspection"/>
    <localInspection language="RouterOS" shortName="RosMissingDoBlock" displayName="Missing do block" groupName="RouterOS"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.dybug.routeros.inspections.RosMissingDoBlockInspection"/>
    <localInspection language="RouterOS" shortName="RosUnreachableCode" displayName="Unreachable code" groupName="RouterOS"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.dybug.routeros.inspections.RosUnreachableCodeInspection"/>
    <localInspection language="RouterOS" shortName="RosCommentAfterValue" displayName="Comment directly after a command" groupName="RouterOS"
                     enabledByDefault="true" level="WARNING" implementationClass="dev.dybug.routeros.inspections.RosCommentAfterValueInspection"/>
    <codeInsight.lineMarkerProvider language="RouterOS"
                                    implementationClass="dev.dybug.routeros.editor.RosFunctionLineMarkerProvider"/>
    <intentionAction>
      <language>RouterOS</language>
      <className>dev.dybug.routeros.intentions.RosConvertPathStyleIntention</className>
      <category>RouterOS</category>
    </intentionAction>
    <intentionAction>
      <language>RouterOS</language>
      <className>dev.dybug.routeros.intentions.RosToggleQuotesIntention</className>
      <category>RouterOS</category>
    </intentionAction>
    <intentionAction>
      <language>RouterOS</language>
      <className>dev.dybug.routeros.intentions.RosWrapOnErrorIntention</className>
      <category>RouterOS</category>
    </intentionAction>
    <lang.formatter language="RouterOS" implementationClass="dev.dybug.routeros.formatting.RosFormattingModelBuilder"/>
    <lang.whiteSpaceFormattingStrategy language="RouterOS"
                                       implementationClass="dev.dybug.routeros.formatting.RosWhiteSpaceFormattingStrategy"/>
    <langCodeStyleSettingsProvider implementation="dev.dybug.routeros.formatting.RosLanguageCodeStyleSettingsProvider"/>
    <liveTemplateContext contextId="ROUTEROS" implementation="dev.dybug.routeros.templates.RosTemplateContextType"/>
    <defaultLiveTemplates file="/liveTemplates/RouterOS.xml"/>
    <internalFileTemplate name="RouterOS Script"/>
    <spellchecker.support language="RouterOS" implementationClass="dev.dybug.routeros.editor.RosSpellcheckingStrategy"/>
    <lang.surroundDescriptor language="RouterOS" implementationClass="dev.dybug.routeros.editor.RosSurroundDescriptor"/>
    <indexPatternBuilder implementation="dev.dybug.routeros.editor.RosIndexPatternBuilder"/>
    <todoIndexer filetype="RouterOS Script" implementationClass="dev.dybug.routeros.editor.RosTodoIndexer"/>
  </extensions>

  <actions>
    <action id="RouterOS.NewFile" class="dev.dybug.routeros.templates.RosCreateFileAction"
            icon="/icons/routeros.svg">
      <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
    </action>
  </actions>
</idea-plugin>
